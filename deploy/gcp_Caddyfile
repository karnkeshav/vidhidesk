# GCP Migration (2026-09-05). Real domain now exists: vidhidesk-api.duckdns.org
# (free DuckDNS dynamic-DNS record), A record verified pointing at this box's
# public IP (35.253.123.223). This is what unblocks HTTPS -- the previous
# bare-IP-only setup made the live app fundamentally unusable, not just
# insecure: a browser will not let an HTTPS page (the Vercel frontend) make
# fetch/XHR calls to a plain-HTTP backend (mixed-content blocking, enforced
# unconditionally, no retry fixes it) -- confirmed the hard way when the
# first cutover attempt failed every request in ~1ms, before any network
# activity, which is that exact signature.
#
# Caddy handles ACME/Let's Encrypt HTTPS automatically for any real
# domain listed as a site block below -- no separate certbot setup
# needed, and plain-HTTP requests on port 80 are redirected to HTTPS
# automatically for any domain block (not the bare-IP :80 block below).
#
# Port 8000 (the FastAPI container from api/Dockerfile) is intentionally
# never exposed directly to the internet -- only Caddy's 443/80 are. The
# GCP firewall (`allow-vidhidesk-http`) is already tightened to just
# 80/443, and the prod container already binds to 127.0.0.1:8000 only
# (deploy/gcp_deploy.sh) -- this Caddyfile is the last piece.

vidhidesk-api.duckdns.org {
	reverse_proxy 127.0.0.1:8000

	encode gzip

	log {
		output file /var/log/caddy/vidhidesk-api-access.log
	}
}

# Fallback while no domain/DNS exists yet: serves plain HTTP on the box's
# bare IP so the deploy pipeline's own health/drift checks have something
# to hit before the domain + HTTPS step is actually done. Remove this
# block once the domain above is live -- it deliberately does NOT get
# HTTPS (Caddy only issues certificates for named domains, never for a
# bare IP), so it must not be the long-term production path.
:80 {
	reverse_proxy 127.0.0.1:8000
}
