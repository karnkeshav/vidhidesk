{
  "template_key": "software-dev",
  "title": "Software Development Agreement",
  "fields": [
    {"key": "party_a_name", "label": "Developer / Vendor Name", "type": "text", "required": true, "help": "Full legal name of software developer / IT vendor"},
    {
      "key": "party_a_entity_type", "label": "Developer Entity Type", "type": "select",
      "options": ["Private Limited Company", "LLP", "Partnership Firm", "Sole Proprietorship"],
      "required": false, "default": "Private Limited Company"
    },
    {"key": "party_a_address", "label": "Developer Address", "type": "textarea", "required": true},
    {"key": "party_b_name", "label": "Client / Customer Name", "type": "text", "required": true, "help": "Full legal name of client receiving software"},
    {
      "key": "party_b_entity_type", "label": "Client Entity Type", "type": "select",
      "options": ["Private Limited Company", "LLP", "Partnership Firm", "Sole Proprietorship", "Individual"],
      "required": false, "default": "Private Limited Company"
    },
    {"key": "party_b_address", "label": "Client Address", "type": "textarea", "required": true},
    {"key": "effective_date", "label": "Effective Date", "type": "date", "required": true},
    {
      "key": "software_name", "label": "Software / Application Name", "type": "text", "required": true,
      "help": "Name of custom software, platform, or mobile app being developed"
    },
    {
      "key": "scope_of_development", "label": "Scope of Work & Deliverables", "type": "textarea", "required": true,
      "help": "Key modules, tech stack, acceptance criteria, and milestones"
    },
    {"key": "total_project_fee", "label": "Total Project Fee (₹)", "type": "text", "required": true},
    {"key": "maintenance_support_included", "label": "Include Annual Maintenance (AMC) Support?", "type": "boolean", "required": false, "default": true},
    {"key": "warranty_period_months", "label": "Bug Fix Warranty Period (Months)", "type": "text", "required": false, "default": "6"},
    {
      "key": "ip_ownership_model", "label": "IP Ownership Model", "type": "select",
      "options": ["Full Client Ownership", "Developer License Model"],
      "required": true, "default": "Full Client Ownership"
    },
    {
      "key": "state", "label": "State Jurisdiction", "type": "select",
      "options": ["Delhi", "Maharashtra", "Uttar Pradesh"],
      "required": true, "default": "Delhi"
    },
    {"key": "arbitration", "label": "Include Arbitration Clause?", "type": "boolean", "required": false, "default": true},
    {"key": "arbitration_seat", "label": "Arbitration Seat", "type": "text", "required": false, "default": "New Delhi"}
  ],
  "groups": [
    {
      "id": "parties",
      "label": "Developer & Client Information",
      "field_keys": ["party_a_name", "party_a_entity_type", "party_a_address", "party_b_name", "party_b_entity_type", "party_b_address"],
      "summary_template": "{{party_a_name}} · {{party_b_name}}"
    },
    {
      "id": "software_scope",
      "label": "Software Scope & Commercials",
      "field_keys": ["effective_date", "software_name", "scope_of_development", "total_project_fee", "maintenance_support_included", "warranty_period_months", "ip_ownership_model"],
      "summary_template": "{{software_name}} · ₹{{total_project_fee}}"
    },
    {
      "id": "jurisdiction_legal",
      "label": "State Rules & Dispute Resolution",
      "field_keys": ["arbitration", "arbitration_seat"],
      "summary_template": "{{arbitration}} · {{arbitration_seat}}"
    }
  ]
}
