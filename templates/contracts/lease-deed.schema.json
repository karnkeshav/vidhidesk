{
  "template_key": "lease-deed",
  "title": "Lease Deed",
  "fields": [
    {"key": "party_a_name", "label": "Lessor Name / Entity", "type": "text", "required": true, "help": "Full legal name of the property owner / lessor"},
    {
      "key": "party_a_entity_type", "label": "Lessor Entity Type", "type": "select",
      "options": ["Individual", "Private Limited Company", "Partnership Firm", "LLP", "HUF"],
      "required": false, "default": "Individual"
    },
    {"key": "party_a_address", "label": "Lessor Address", "type": "textarea", "required": true},
    {"key": "party_b_name", "label": "Lessee Name / Entity", "type": "text", "required": true, "help": "Full legal name of the tenant / lessee"},
    {
      "key": "party_b_entity_type", "label": "Lessee Entity Type", "type": "select",
      "options": ["Individual", "Private Limited Company", "Partnership Firm", "LLP", "HUF"],
      "required": false, "default": "Private Limited Company"
    },
    {"key": "party_b_address", "label": "Lessee Address", "type": "textarea", "required": true},
    {"key": "effective_date", "label": "Lease Commencement Date", "type": "date", "required": true},
    {
      "key": "property_address", "label": "Leased Property Address", "type": "textarea", "required": true,
      "help": "Complete description of demised premises"
    },
    {"key": "monthly_rent", "label": "Monthly Rent Amount (₹)", "type": "text", "required": true},
    {"key": "security_deposit", "label": "Interest-Free Security Deposit (₹)", "type": "text", "required": true},
    {"key": "lease_term_years", "label": "Lease Term (Years)", "type": "text", "required": true, "default": "3"},
    {"key": "rent_escalation_pct", "label": "Annual Rent Escalation (%)", "type": "text", "required": false, "default": "5%"},
    {
      "key": "property_type", "label": "Property Type", "type": "select",
      "options": ["Commercial Office", "Industrial Warehouse", "Residential Property"],
      "required": false, "default": "Commercial Office"
    },
    {
      "key": "state", "label": "State Jurisdiction", "type": "select",
      "options": ["Delhi", "Maharashtra", "Uttar Pradesh"],
      "required": true, "default": "Delhi"
    },
    {"key": "arbitration", "label": "Include Arbitration Clause?", "type": "boolean", "required": false, "default": true},
    {"key": "arbitration_seat", "label": "Arbitration Seat", "type": "text", "required": false, "default": "New Delhi"}
  ],
  "groups": [
    {
      "id": "parties",
      "label": "Lessor & Lessee Information",
      "field_keys": ["party_a_name", "party_a_entity_type", "party_a_address", "party_b_name", "party_b_entity_type", "party_b_address"],
      "summary_template": "{{party_a_name}} · {{party_b_name}}"
    },
    {
      "id": "lease_terms",
      "label": "Demised Property & Rent Commercials",
      "field_keys": ["effective_date", "property_address", "monthly_rent", "security_deposit", "lease_term_years", "rent_escalation_pct", "property_type"],
      "summary_template": "{{property_address}} · ₹{{monthly_rent}}"
    },
    {
      "id": "jurisdiction_legal",
      "label": "State Rules & Dispute Resolution",
      "field_keys": ["arbitration", "arbitration_seat"],
      "summary_template": "{{arbitration}} · {{arbitration_seat}}"
    }
  ]
}
