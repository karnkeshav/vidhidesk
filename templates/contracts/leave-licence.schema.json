{
  "template_key": "leave-licence",
  "title": "Leave and Licence Agreement",
  "fields": [
    {"key": "party_a_name", "label": "Licensor Name / Company", "type": "text", "required": true, "help": "Full legal name of the property owner / licensor"},
    {
      "key": "party_a_entity_type", "label": "Licensor Entity Type", "type": "select",
      "options": ["Individual", "Private Limited Company", "Partnership Firm", "LLP", "HUF", "Sole Proprietorship"],
      "required": false, "default": "Individual"
    },
    {"key": "party_a_address", "label": "Licensor Registered Address", "type": "textarea", "required": true},
    {"key": "party_b_name", "label": "Licensee Name / Company", "type": "text", "required": true, "help": "Full legal name of the licensee / occupant"},
    {
      "key": "party_b_entity_type", "label": "Licensee Entity Type", "type": "select",
      "options": ["Individual", "Private Limited Company", "Partnership Firm", "LLP", "HUF", "Sole Proprietorship"],
      "required": false, "default": "Individual"
    },
    {"key": "party_b_address", "label": "Licensee Permanent / Registered Address", "type": "textarea", "required": true},
    {"key": "effective_date", "label": "Licence Commencement Date", "type": "date", "required": true},
    {
      "key": "property_address", "label": "Licensed Property Address", "type": "textarea", "required": true,
      "help": "Complete description of the licensed residential / commercial premises"
    },
    {
      "key": "licence_fee_monthly", "label": "Monthly Licence Fee (₹)", "type": "text", "required": true,
      "help": "Monthly licence fee amount payable by licensee"
    },
    {"key": "security_deposit", "label": "Interest-Free Security Deposit (₹)", "type": "text", "required": true},
    {"key": "licence_period_months", "label": "Licence Period (Months)", "type": "text", "required": true, "default": "11"},
    {"key": "lock_in_period_months", "label": "Lock-in Period (Months)", "type": "text", "required": false, "default": "6"},
    {
      "key": "purpose_of_use", "label": "Purpose of Use", "type": "select",
      "options": ["Residential Premises", "Commercial Office / Workspace"],
      "required": false, "default": "Residential Premises"
    },
    {
      "key": "state", "label": "State Jurisdiction", "type": "select",
      "options": ["Delhi", "Maharashtra", "Uttar Pradesh"],
      "required": true, "default": "Maharashtra"
    },
    {"key": "arbitration", "label": "Include Arbitration Clause?", "type": "boolean", "required": false, "default": false},
    {"key": "arbitration_seat", "label": "Arbitration Seat / City", "type": "text", "required": false, "default": "Mumbai"}
  ],
  "groups": [
    {
      "id": "parties",
      "label": "Parties Information",
      "field_keys": ["party_a_name", "party_a_entity_type", "party_a_address", "party_b_name", "party_b_entity_type", "party_b_address"],
      "summary_template": "{{party_a_name}} · {{party_b_name}}"
    },
    {
      "id": "property_terms",
      "label": "Licensed Property & Commercial Terms",
      "field_keys": ["effective_date", "property_address", "licence_fee_monthly", "security_deposit", "licence_period_months", "lock_in_period_months", "purpose_of_use"],
      "summary_template": "{{property_address}} · ₹{{licence_fee_monthly}}"
    },
    {
      "id": "jurisdiction_legal",
      "label": "State Rules & Dispute Resolution",
      "field_keys": ["arbitration", "arbitration_seat"],
      "summary_template": "{{arbitration}} · {{arbitration_seat}}"
    }
  ]
}
