{
  "template_key": "joint-venture",
  "title": "Joint Venture Agreement",
  "fields": [
    {"key": "party_a_name", "label": "JV Partner A Name", "type": "text", "required": true, "help": "Full legal name of first joint venture partner"},
    {
      "key": "party_a_entity_type", "label": "Partner A Entity Type", "type": "select",
      "options": ["Private Limited Company", "LLP", "Partnership Firm", "Individual"],
      "required": false, "default": "Private Limited Company"
    },
    {"key": "party_a_address", "label": "Partner A Registered Address", "type": "textarea", "required": true},
    {"key": "party_b_name", "label": "JV Partner B Name", "type": "text", "required": true, "help": "Full legal name of second joint venture partner"},
    {
      "key": "party_b_entity_type", "label": "Partner B Entity Type", "type": "select",
      "options": ["Private Limited Company", "LLP", "Partnership Firm", "Individual"],
      "required": false, "default": "Private Limited Company"
    },
    {"key": "party_b_address", "label": "Partner B Registered Address", "type": "textarea", "required": true},
    {"key": "effective_date", "label": "Agreement Date", "type": "date", "required": true},
    {
      "key": "jv_purpose", "label": "Joint Venture Scope & Objective", "type": "textarea", "required": true,
      "help": "Core commercial business objective of the joint venture"
    },
    {
      "key": "jv_entity_type", "label": "JV Structure", "type": "select",
      "options": ["Incorporated Company JV", "Unincorporated Contractual JV"],
      "required": true, "default": "Incorporated Company JV"
    },
    {"key": "party_a_equity_share_pct", "label": "Partner A Shareholding / Ratio (%)", "type": "text", "required": true, "default": "50%"},
    {"key": "party_b_equity_share_pct", "label": "Partner B Shareholding / Ratio (%)", "type": "text", "required": true, "default": "50%"},
    {
      "key": "capital_contribution_details", "label": "Initial Capital Contribution Details", "type": "textarea", "required": false,
      "help": "Capital amount and assets contributed by each partner"
    },
    {
      "key": "state", "label": "State Jurisdiction", "type": "select",
      "options": ["Delhi", "Maharashtra", "Uttar Pradesh"],
      "required": true, "default": "Delhi"
    },
    {"key": "arbitration", "label": "Include Institutional Arbitration?", "type": "boolean", "required": false, "default": true},
    {"key": "arbitration_seat", "label": "Arbitration Seat", "type": "text", "required": false, "default": "New Delhi"}
  ],
  "groups": [
    {
      "id": "parties",
      "label": "Joint Venture Partners",
      "field_keys": ["party_a_name", "party_a_entity_type", "party_a_address", "party_b_name", "party_b_entity_type", "party_b_address"],
      "summary_template": "{{party_a_name}} · {{party_b_name}}"
    },
    {
      "id": "jv_structure",
      "label": "JV Purpose & Capital Structure",
      "field_keys": ["effective_date", "jv_purpose", "jv_entity_type", "party_a_equity_share_pct", "party_b_equity_share_pct", "capital_contribution_details"],
      "summary_template": "{{jv_purpose}} · {{jv_entity_type}}"
    },
    {
      "id": "jurisdiction_legal",
      "label": "State Rules & Dispute Resolution",
      "field_keys": ["arbitration", "arbitration_seat"],
      "summary_template": "{{arbitration}} · {{arbitration_seat}}"
    }
  ]
}
